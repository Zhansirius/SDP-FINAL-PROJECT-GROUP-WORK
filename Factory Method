interface Dish {
    String getName();
    double getPrice();
}

class Pizza implements Dish {
    @Override
    public String getName() {
        return "Pizza";
    }

    @Override
    public double getPrice() {
        return 2800;
    }
}

class Drink implements Dish {
    @Override
    public String getName() {
        return "Drink";
    }

    @Override
    public double getPrice() {
        return 800;
    }
}

class Dessert implements Dish {
    @Override
    public String getName() {
        return "Dessert";
    }

    @Override
    public double getPrice() {
        return 1500;
    }
}

abstract class DishFactory {
    public abstract Dish createDish();
}

class PizzaFactory extends DishFactory {
    @Override
    public Dish createDish() {
        return new Pizza();
    }
}

class DrinkFactory extends DishFactory {
    @Override
    public Dish createDish() {
        return new Drink();
    }
}

class DessertFactory extends DishFactory {
    @Override
    public Dish createDish() {
        return new Dessert();
    }
}
